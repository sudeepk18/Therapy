# Unfazed Backend – .gitignore

# ── Dependencies ──────────────────────────────
node_modules/

# ── Environment Variables ──────────────────────
.env
.env.local
.env.*.local

# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Runtime ───────────────────────────────────
pids/
*.pid
*.seed

# ── Build Output ──────────────────────────────
dist/
build/

# ── Editor ────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# ── Backup ────────────────────────────────────
*.git_bak
.git_bak/

# ── OS ────────────────────────────────────────
.DS_Store
Thumbs.db
